# ParadeDB Configuration Example
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# Image: paradedb/paradedb:0.25.0-pg17

# PostgreSQL 超级用户 (admin user)
POSTGRES_USER=paradedb

# PostgreSQL 超级用户密码 (admin password)
POSTGRES_PASSWORD=paradedb

# 默认创建的数据库名 (default database name)
POSTGRES_DB=paradedb

# 主机对外暴露的端口 (host port exposed for remote connections)
# 修改后重启 docker compose 即可生效
POSTGRES_PORT=5432
